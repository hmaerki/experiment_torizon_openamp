{
	"folders": [
		{
			"path": "."
		},
		{
			"name": "productxy-meta",
			"path": "yocto-workdir/layers/meta-productxy"
		},
		{
			"name": "torizon_openamp_manifest",
			"path": "../torizon_openamp_manifest"
		},
		{
			"name": "meta-toradex-torizon",
			"path": "../meta-toradex-torizon"
		},
		{
			"name": "toradex-manifest",
			"path": "../toradex-manifest"
		}
	],
	"settings": {
		"[c]": {
			"editor.defaultFormatter": "ms-vscode.cpptools"
		},
		"[cpp]": {
			"editor.defaultFormatter": "ms-vscode.cpptools"
		},
		"[python]": {
			"editor.defaultFormatter": "charliermarsh.ruff",
			"editor.formatOnSave": true
		},
		"editor.formatOnSave": true,
		"C_Cpp.default.includePath": [
			"${workspaceFolder}/hmp_mcuxpresso-zephyr/src"
		],
		"C_Cpp.default.browse.path": [
			"${workspaceFolder}/hmp_mcuxpresso-zephyr/src"
		],
		//		"files.exclude": {
		//			"**/*": true,
		//			"${workspaceFolder}/**/src/**": false
		//		},
		"files.watcherExclude": {
			"${workspaceFolder}/yocto-workdir/**": true,
			"${workspaceFolder}/hmp_zephyr/zephyr/**": true,
			"${workspaceFolder}/hmp_mcuxpresso-zephyr/zephyr/**": true,
		},
		"C_Cpp.codeAnalysis.in": {},
		"python.analysis.include": [
			"${workspaceFolder}/hmp_mcuxpresso-zephyr/src"
		],
		"python.linting.enabled": false,
		"python.linting.pylintEnabled": false,
		"python.linting.mypyEnabled": false,
		"python.linting.flake8Enabled": false,
		"python.linting.pycodestyleEnabled": false,
		"python.analysis.typeCheckingMode": "off",
		"python.analysis.diagnosticMode": "openFilesOnly"
	}
}